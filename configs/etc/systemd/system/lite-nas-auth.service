[Unit]
Description=LiteNAS auth service
After=network-online.target nats-server.service lite-nas-rbac.service
Wants=network-online.target
Requires=nats-server.service

[Service]
Type=simple
User=root
Group=root
SupplementaryGroups=lite-nas
ExecStart=/usr/libexec/lite-nas/auth-service
Restart=on-failure
RestartSec=5s
WorkingDirectory=/
# PAM's unix_chkpwd helper needs its AppArmor profile transition.
NoNewPrivileges=no
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.1
IPAddressAllow=::1
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
# PAM needs to read the account database and preserve shadow-file ownership
# while replacing it with a temporary file during password changes.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_CHOWN
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_CHOWN
UMask=0027
StateDirectory=lite-nas-auth
StateDirectoryMode=0700
ReadOnlyPaths=/etc/lite-nas
# pam_unix creates and renames temporary files in /etc when updating passwords.
ReadWritePaths=/etc /var/log/lite-nas/auth-service.log /var/lib/lite-nas-auth
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
