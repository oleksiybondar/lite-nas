abi <abi/4.0>,

include <tunables/global>

profile /usr/libexec/lite-nas/backup-restore flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/lite-nas-go-base>
  include <abstractions/lite-nas-nats-client>

  capability dac_override,
  capability dac_read_search,
  capability chown,
  capability fowner,
  capability net_admin,
  capability net_raw,

  network netlink raw,
  network inet raw,
  network inet6 raw,

  /usr/libexec/lite-nas/backup-restore mr,
  /etc/lite-nas/backup-restore.conf r,
  /etc/lite-nas/backup.d/ r,
  /etc/lite-nas/backup.d/*.conf rw,
  /etc/lite-nas/backup.d/.restore-* rwk,
  /etc/lite-nas/*.conf rw,
  /etc/lite-nas/before-startup.sh rwk,
  /etc/lite-nas/.restore-* rwk,
  /etc/aide/ r,
  /etc/aide/aide.conf rw,
  /etc/aide/.restore-* rwk,
  /etc/aide/aide.conf.d/ r,
  /etc/aide/aide.conf.d/* rw,
  /etc/aide/aide.conf.d/.restore-* rwk,
  /etc/nats-server.conf rw,
  /etc/.restore-* rwk,
  /etc/nats-server/ r,
  /etc/nats-server/** rwk,
  /etc/nats-server/.restore-* rwk,
  /etc/lite-nas/log-analysis/ r,
  /etc/lite-nas/log-analysis/** rwk,
  /etc/lite-nas/resources-monitor/ r,
  /etc/lite-nas/resources-monitor/** rwk,
  /etc/lite-nas/security-automation/ r,
  /etc/lite-nas/security-automation/** rwk,
  /etc/lite-nas/security-email-notifier/ r,
  /etc/lite-nas/security-email-notifier/** rwk,
  /etc/lite-nas/system-email-notifier/ r,
  /etc/lite-nas/system-email-notifier/** rwk,
  /etc/lite-nas/certificates/auth/token-signing.crt r,
  /etc/lite-nas/certificates/ r,
  /etc/lite-nas/certificates/transport/ r,
  /etc/lite-nas/certificates/transport/** rwk,
  /etc/lite-nas/certificates/auth/ r,
  /etc/lite-nas/certificates/auth/** rwk,
  /etc/lite-nas/certificates/identities/ r,
  /etc/lite-nas/certificates/identities/** rwk,
  /etc/lite-nas/certificates/nginx/ rw,
  /etc/lite-nas/certificates/nginx/** rwk,
  /etc/apt/ r,
  /etc/apt/.restore-* rwk,
  /etc/apt/apt.conf rw,
  /etc/apt/apt.conf.d/ rw,
  /etc/apt/apt.conf.d/** rwk,
  /etc/apt/sources.list rw,
  /etc/apt/sources.list.d/ rw,
  /etc/apt/sources.list.d/** rwk,
  /etc/apt/preferences rw,
  /etc/apt/preferences.d/ rw,
  /etc/apt/preferences.d/** rwk,
  /etc/apt/trusted.gpg rw,
  /etc/apt/trusted.gpg.d/ rw,
  /etc/apt/trusted.gpg.d/** rwk,
  /etc/apt/keyrings/ rw,
  /etc/apt/keyrings/** rwk,
  /etc/nginx/ rw,
  /etc/nginx/** rwk,
  /etc/sudoers rw,
  /etc/sudoers.d/ rw,
  /etc/sudoers.d/** rwk,
  /etc/polkit-1/rules.d/ rw,
  /etc/polkit-1/rules.d/** rwk,
  /etc/sysctl.conf rw,
  /etc/sysctl.d/ rw,
  /etc/sysctl.d/** rwk,
  /etc/modprobe.d/ rw,
  /etc/modprobe.d/** rwk,
  /etc/modules rw,
  /etc/modules-load.d/ rw,
  /etc/modules-load.d/** rwk,
  /etc/fstab rw,
  /etc/crypttab rw,
  /etc/chrony/ rw,
  /etc/chrony/** rwk,
  /etc/chrony.conf rw,
  /etc/logrotate.conf rw,
  /etc/logrotate.d/ rw,
  /etc/logrotate.d/** rwk,
  /etc/pam.d/ rw,
  /etc/pam.d/** rwk,
  /etc/security/ rw,
  /etc/security/** rwk,
  /etc/audit/ rw,
  /etc/audit/** rwk,
  /etc/ssh/ rw,
  /etc/ssh/sshd_config rw,
  /etc/ssh/.restore-* rwk,
  /etc/ssh/sshd_config.d/ rw,
  /etc/ssh/sshd_config.d/** rwk,
  /etc/systemd/ r,
  /etc/systemd/journald.conf rw,
  /etc/systemd/.restore-* rwk,
  /etc/systemd/journald.conf.d/ rw,
  /etc/systemd/journald.conf.d/** rwk,
  /etc/systemd/timesyncd.conf rw,
  /etc/systemd/timesyncd.conf.d/ rw,
  /etc/systemd/timesyncd.conf.d/** rwk,
  /etc/default/ r,
  /etc/default/grub rw,
  /etc/default/.restore-* rwk,
  /etc/default/grub.d/ rw,
  /etc/default/grub.d/** rwk,
  /etc/grub.d/ rw,
  /etc/grub.d/** rwk,
  /etc/netplan/ rw,
  /etc/netplan/** rwk,
  /etc/usbguard/ r,
  /etc/usbguard/usbguard-daemon.conf rw,
  /etc/usbguard/rules.conf rw,
  /etc/usbguard/.restore-* rwk,
  /etc/cloudflared/ rw,
  /etc/cloudflared/** rwk,
  /usr/local/etc/cloudflared/ rw,
  /usr/local/etc/cloudflared/** rwk,
  /usr/bin/cloudflared ix,
  /usr/bin/tailscale ix,
  /run/tailscale/ r,
  /run/tailscale/** rw,
  # The UFW CLI owns its rule files and activates policy through netfilter.
  /etc/ufw/ufw.conf rw,
  /etc/ufw/.restore-* rwk,
  /etc/default/ufw rw,
  /etc/ufw/ r,
  /etc/ufw/** rwk,
  /tmp/ r,
  /tmp/tmp* rwk,
  /run/ufw* rwk,
  /run/xtables.lock rwk,
  /lib/ufw/** rix,
  /usr/lib/ufw/** rix,
  /usr/lib/python3/** r,
  /usr/lib/python3*/** r,
  # Python scans local site packages and reads the UFW script after execution.
  /usr/local/lib/python3*/dist-packages/ r,
  /usr/share/ufw/** r,
  /usr/sbin/ufw rix,
  /usr/bin/python3* ix,
  /usr/sbin/iptables* ix,
  /usr/sbin/ip6tables* ix,
  /usr/sbin/xtables-* ix,
  /usr/sbin/sysctl ix,
  /usr/sbin/modprobe ix,
  /usr/bin/grep ix,
  /bin/sh ix,
  /proc/sys/** rw,
  /etc/postfix/main.cf rw,
  /etc/postfix/master.cf rw,
  /etc/postfix/.restore-* rwk,
  /etc/rsyslog.d/30-lite-nas-log-analysis.conf rw,
  /etc/rsyslog.d/.restore-* rwk,
  /etc/systemd/system/lite-nas-* rw,
  /etc/systemd/system/.restore-* rwk,
  /etc/apparmor.d/usr.libexec.lite-nas.* rw,
  /etc/apparmor.d/abstractions/ r,
  /etc/apparmor.d/abstractions/lite-nas-* rw,
  /etc/apparmor.d/abstractions/.restore-* rwk,
  /etc/apparmor.d/usr.lib.postfix.sbin rw,
  /etc/apparmor.d/.restore-* rwk,
  /etc/apparmor.d/rsyslog.d/ r,
  /etc/apparmor.d/rsyslog.d/lite-nas-log-analysis rw,
  /etc/apparmor.d/rsyslog.d/.restore-* rwk,
  /var/lib/lite-nas/backup/ rw,
  /var/lib/lite-nas/backup/** rwkl,
  /var/lib/aide/ rw,
  /var/lib/aide/** rwk,
  /var/log/lite-nas/backup-restore.log rw,

  include if exists <local/usr.libexec.lite-nas.backup-restore>
}
