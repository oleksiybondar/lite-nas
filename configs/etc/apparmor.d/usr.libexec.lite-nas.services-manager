abi <abi/4.0>,

include <tunables/global>

profile /usr/libexec/lite-nas/services-manager flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/lite-nas-go-base>
  include <abstractions/authentication>

  # sudo keeps this profile while switching to root for the fixed systemctl verbs.
  capability setuid,
  capability setgid,

  network inet stream,
  network inet6 stream,
  network unix stream,
  network unix dgram,

  /usr/libexec/lite-nas/services-manager mr,
  /etc/lite-nas/services-manager.conf r,
  /var/log/lite-nas/services-manager.log rw,
  /etc/lite-nas/certificates/transport/ r,
  /etc/lite-nas/certificates/transport/root-ca.crt r,
  /etc/lite-nas/certificates/transport/lite-nas-services-manager/ r,
  /etc/lite-nas/certificates/transport/lite-nas-services-manager/client.{crt,key} r,
  /etc/lite-nas/certificates/auth/ r,
  /etc/lite-nas/certificates/auth/token-signing.crt r,

  /usr/bin/systemctl ix,
  /run/systemd/ r,
  /run/systemd/private rw,
  /run/dbus/system_bus_socket rw,
  dbus (send, receive) bus=system peer=(name="org.freedesktop.systemd1"),
  /etc/systemd/system/ r,
  /etc/systemd/system/** r,
  /run/systemd/system/ r,
  /run/systemd/system/** r,
  /usr/lib/systemd/system/ r,
  /usr/lib/systemd/system/** r,

  /usr/bin/sudo ix,
  /usr/lib/cargo/bin/sudo ix,
  /usr/lib/sudo/** mr,
  /usr/libexec/sudo/** mr,
  /etc/sudo.conf r,
  /etc/sudoers r,
  /etc/sudoers.d/ r,
  /etc/sudoers.d/** r,
  /run/sudo/** rwk,
  /var/db/sudo/** rwk,
  /var/lib/sudo/** rwk,

  include if exists <local/usr.libexec.lite-nas.services-manager>
}
