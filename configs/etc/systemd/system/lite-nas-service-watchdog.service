[Unit]
Description=LiteNAS service watchdog service
After=network-online.target nats-server.service lite-nas-security-logging-manager.service systemd-journald.service apparmor.service usbguard.service ufw.service lite-nas-auth.service lite-nas-rbac.service lite-nas-security-logging-manager.service lite-nas-system-logging-manager.service lite-nas-security-email-notifier.service lite-nas-system-email-notifier.service lite-nas-system-metrics.service lite-nas-network-metrics.service lite-nas-process-metrics.service lite-nas-disk-metrics.service lite-nas-service-metrics.service lite-nas-zfs-metrics.service lite-nas-resources-monitor.service lite-nas-integrity.service lite-nas-mount-monitor.service lite-nas-antivirus.service lite-nas-system-service-monitor.service lite-nas-log-analysis.service
Wants=network-online.target
Requires=nats-server.service

[Service]
Type=simple
User=lite-nas-service-watchdog
Group=lite-nas-service-watchdog
ExecStart=/usr/libexec/lite-nas/service-watchdog
Restart=on-failure
RestartSec=5s
WorkingDirectory=/
NoNewPrivileges=no
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.1
IPAddressAllow=::1
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=
UMask=0027
ReadOnlyPaths=/etc/lite-nas/service-watchdog.conf /etc/lite-nas/certificates/transport /etc/lite-nas/certificates/identities
ReadWritePaths=/var/log/lite-nas/service-watchdog.log -/run/sudo -/var/lib/sudo -/var/db/sudo
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
