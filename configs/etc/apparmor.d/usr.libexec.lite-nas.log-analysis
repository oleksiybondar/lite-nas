abi <abi/4.0>,

include <tunables/global>

profile /usr/libexec/lite-nas/log-analysis flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/lite-nas-go-base>
  include <abstractions/lite-nas-nats-client>
  include <abstractions/lite-nas-auth-client>

  /usr/libexec/lite-nas/log-analysis mr,
  /etc/lite-nas/log-analysis.conf r,
  /var/log/lite-nas/log-analysis.log rw,
  /etc/lite-nas/log-analysis/ r,
  /etc/lite-nas/log-analysis/** r,
  # Records arrive on the datagram socket inherited from lite-nas-log-analysis.socket.
  unix (receive, getattr, getopt, setopt) type=dgram,

  include if exists <local/usr.libexec.lite-nas.log-analysis>
}
