abi <abi/4.0>,

include <tunables/global>

profile /usr/libexec/lite-nas/mount-monitor flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/lite-nas-go-base>
  include <abstractions/lite-nas-nats-client>
  include <abstractions/lite-nas-auth-client>

  /usr/libexec/lite-nas/mount-monitor mr,
  /etc/lite-nas/mount-monitor.conf r,
  /var/log/lite-nas/mount-monitor.log rw,
  /proc/*/mountinfo r,

  include if exists <local/usr.libexec.lite-nas.mount-monitor>
}
