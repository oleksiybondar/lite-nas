abi <abi/4.0>,

include <tunables/global>

profile /usr/libexec/lite-nas/file-service flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/lite-nas-go-base>
  include <abstractions/lite-nas-nats-client>
  include <abstractions/authentication>

  # The inherited sudo process drops to the RBAC-verified Unix account.
  capability setgid,
  capability setuid,

  /usr/libexec/lite-nas/file-service mr,
  /proc/*/stat r,
  /etc/default/locale r,
  /etc/lite-nas/file-service.conf r,
  /proc/sys/net/core/somaxconn r,
  /var/log/lite-nas/file-service.log rw,
  /var/lib/lite-nas/file-service/ rw,
  /var/lib/lite-nas/file-service/** rwk,
  /run/lite-nas-file-service/ rw,
  /run/lite-nas-file-service/** rwk,
  # Listing these directories needs read access to the directory itself.
  / r,
  /etc/ r,
  /var/ r,
  /var/log/ r,
  /proc/ r,
  /sys/ r,
  /home/ r,
  /home/** r,
  # Removable and operator-mounted storage is available for listing and reads.
  /mnt/ r,
  /mnt/** r,
  /media/ r,
  /media/** r,
  # AppArmor cannot match a filesystem type. Permit reads under root-level
  # mount trees; File Service checks configured roots and mounted ZFS roots.
  /*/ r,
  /*/** r,
  # These fixed commands may resolve to the installed alternative targets.
  /usr/bin/sudo ix,
  /usr/lib/cargo/bin/sudo ix,
  /usr/lib/sudo/** mr,
  /usr/libexec/sudo/** mr,
  /etc/sudo.conf r,
  /etc/sudoers r,
  /etc/sudoers.d/ r,
  /etc/sudoers.d/** r,
  /run/sudo/** rwk,
  /var/db/sudo/** rwk,
  /var/lib/sudo/** rwk,
  /bin/cat ix,
  /usr/lib/cargo/bin/coreutils/cat ix,
  /bin/rm Cx -> file-operations,
  /usr/bin/gnurm Cx -> file-operations,
  /bin/mkdir Cx -> file-operations,
  /bin/rmdir Cx -> file-operations,
  /usr/lib/cargo/bin/coreutils/mkdir Cx -> file-operations,
  /usr/lib/cargo/bin/coreutils/rmdir Cx -> file-operations,
  /usr/libexec/lite-nas/lite-nas-file-writer Px,

  # Only user-scoped fixed commands receive host mutation access.
  profile file-operations {
    include <abstractions/base>
    include <abstractions/nameservice>

    /bin/rm mr,
    /usr/bin/gnurm mr,
    /bin/mkdir mr,
    /bin/rmdir mr,
    /usr/lib/cargo/bin/coreutils/mkdir mr,
    /usr/lib/cargo/bin/coreutils/rmdir mr,
    /home/ r,
    /home/** rw,
    /mnt/ rw,
    /mnt/** rwk,
    /media/ rw,
    /media/** rwk,
    # AppArmor cannot match a filesystem type. Permit file operations under
    # root-level mount trees; File Service restricts targets to write_roots.
    /*/ rw,
    /*/** rwk,
    deny /boot/ w,
    deny /boot/** w,
    deny /bin/ w,
    deny /bin/** w,
    deny /dev/ w,
    deny /dev/** w,
    deny /etc/ w,
    deny /etc/** w,
    deny /lib/ w,
    deny /lib/** w,
    deny /lib64/ w,
    deny /lib64/** w,
    deny /proc/ w,
    deny /proc/** w,
    deny /root/ w,
    deny /root/** w,
    deny /run/ w,
    deny /run/** w,
    deny /sbin/ w,
    deny /sbin/** w,
    deny /sys/ w,
    deny /sys/** w,
    deny /usr/ w,
    deny /usr/** w,
    deny /var/lib/ w,
    deny /var/lib/** w,
    include if exists <local/usr.libexec.lite-nas.file-operations>
  }

  include if exists <local/usr.libexec.lite-nas.file-service>
}
