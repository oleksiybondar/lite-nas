abi <abi/4.0>,

include <tunables/global>

profile /usr/libexec/lite-nas/litenas-integrity flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/lite-nas-go-base>
  include <abstractions/lite-nas-nats-client>
  include <abstractions/lite-nas-auth-client>

  /usr/libexec/lite-nas/litenas-integrity mr,
  /etc/lite-nas/litenas-integrity.conf r,
  /var/log/lite-nas/lite-nas-integrity.log rw,

  /usr/bin/aide ix,
  /usr/bin/sudo ix,
  /bin/mv ix,
  /usr/lib/sudo/** mr,
  /usr/libexec/sudo/** mr,
  /etc/sudo.conf r,
  /etc/sudoers r,
  /etc/sudoers.d/ r,
  /etc/sudoers.d/** r,
  /run/sudo/** rwk,
  /var/db/sudo/** rwk,
  /var/lib/sudo/** rwk,

  include if exists <local/usr.libexec.lite-nas.litenas-integrity>
}
