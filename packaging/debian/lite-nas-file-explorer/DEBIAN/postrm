#!/bin/sh
set -e

case "$1" in
    remove|purge)
        rm -f /usr/share/lite-nas/nginx/file-explorer.conf
        if command -v nginx >/dev/null 2>&1 && command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet nginx; then
            nginx -t
            systemctl reload nginx
        fi
        ;;
esac
