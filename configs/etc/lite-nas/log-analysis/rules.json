{
  "sources": [{ "id": "auth", "path": "/var/log/auth.log", "format": "rsyslog_auth" }],
  "instances": [
    {
      "id": "account_retry",
      "enabled": true,
      "type": "keyed_threshold",
      "threshold": 3,
      "window": "2m",
      "cooldown": "3m",
      "idle": "30m",
      "key_by": "account",
      "max_keys": 2048
    },
    {
      "id": "source_probing",
      "enabled": false,
      "type": "keyed_threshold",
      "threshold": 12,
      "window": "5m",
      "cooldown": "30m",
      "idle": "1h",
      "key_by": "source",
      "max_keys": 2048
    }
  ],
  "rules": [
    {
      "id": "pam_password_guessing",
      "enabled": true,
      "source": "auth",
      "category": "password_guessing",
      "pattern": "pam_unix\\(litenas-auth:auth\\): authentication failure",
      "success_pattern": "pam_unix\\(litenas-auth:session\\): session opened for user",
      "instance": "account_retry",
      "severity": "warning",
      "lockdown": false
    },
    {
      "id": "pam_source_probing",
      "enabled": false,
      "source": "auth",
      "category": "password_guessing",
      "pattern": "pam_unix\\(litenas-auth:auth\\): authentication failure",
      "instance": "source_probing",
      "severity": "critical",
      "email_on_critical": true,
      "lockdown": false
    }
  ]
}
