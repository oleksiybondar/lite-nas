[Unit]
Description=LiteNAS antivirus service
After=network-online.target nats-server.service lite-nas-auth.service lite-nas-rbac.service lite-nas-security-logging-manager.service lite-nas-system-logging-manager.service lite-nas-before-startup.service
Wants=network-online.target lite-nas-auth.service lite-nas-rbac.service lite-nas-security-logging-manager.service lite-nas-system-logging-manager.service
Requires=nats-server.service lite-nas-before-startup.service

[Service]
Type=simple
User=lite-nas-antivirus
Group=lite-nas-antivirus
ExecStart=/usr/libexec/lite-nas/antivirus
Restart=on-failure
RestartSec=5s
WorkingDirectory=/
NoNewPrivileges=no
# Scans must read files owned by any user without changing them.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID
# Scan removable media without crossing into other mounted filesystems.
ReadOnlyPaths=/media /mnt
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=127.0.0.1
IPAddressAllow=::1
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
AmbientCapabilities=CAP_DAC_READ_SEARCH
UMask=0027
ReadOnlyPaths=/etc/lite-nas/antivirus.conf /etc/lite-nas/certificates/transport /etc/lite-nas/certificates/identities
ReadWritePaths=/var/log/lite-nas/antivirus.log
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
