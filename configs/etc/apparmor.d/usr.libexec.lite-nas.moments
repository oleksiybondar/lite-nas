abi <abi/4.0>,

include <tunables/global>

profile /usr/libexec/lite-nas/moments flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/lite-nas-go-base>
  include <abstractions/lite-nas-nats-client>
  include <abstractions/lite-nas-auth-client>

  /usr/libexec/lite-nas/moments mr,
  /etc/lite-nas/moments.conf r,
  /etc/lite-nas/certificates/auth/token-signing.crt r,
  /usr/share/lite-nas/moments/cities1000.zip r,
  /proc/sys/net/core/somaxconn r,
  /var/log/lite-nas/moments.log rw,
  /var/lib/lite-nas/moments/ rw,
  /var/lib/lite-nas/moments/moments.db{,-shm,-wal,-journal} rwk,
  /var/lib/lite-nas/moments/thumbnails/ rw,
  /var/lib/lite-nas/moments/thumbnails/* rwk,

  include if exists <local/usr.libexec.lite-nas.moments>
}
