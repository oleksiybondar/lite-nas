abi <abi/4.0>,

include <tunables/global>

profile /usr/libexec/lite-nas/process-metrics flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/lite-nas-go-base>
  include <abstractions/lite-nas-nats-client>

  /usr/libexec/lite-nas/process-metrics mr,
  /etc/lite-nas/process-metrics.conf r,
  /var/log/lite-nas/process-metrics.log rw,
  /proc/ r,
  /proc/stat r,
  /proc/[0-9]*/ r,
  /proc/[0-9]*/stat r,
  /proc/[0-9]*/status r,
  /proc/[0-9]*/cmdline r,
  /proc/[0-9]*/exe r,
  /proc/[0-9]*/cwd r,
  /proc/[0-9]*/fd/ r,
  /proc/[0-9]*/fd/** r,

  include if exists <local/usr.libexec.lite-nas.process-metrics>
}
