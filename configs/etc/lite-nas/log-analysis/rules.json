{
  "event_id_prefix": "secauth",
  "sources": [
    { "id": "auth", "format": "auth", "facilities": ["auth", "authpriv"] },
    { "id": "kernel", "format": "kernel", "inputs": ["imklog"] }
  ],
  "instances": [
    {
      "id": "single_failure",
      "enabled": true,
      "type": "immediate",
      "threshold": 1,
      "window": "1m",
      "cooldown": "1m",
      "idle": "2m",
      "key_by": "global",
      "max_keys": 2048
    },
    {
      "id": "account_retry",
      "enabled": true,
      "type": "keyed_threshold",
      "threshold": 3,
      "window": "2m",
      "cooldown": "3m",
      "idle": "30m",
      "key_by": "account",
      "max_keys": 2048
    },
    {
      "id": "unknown_account_retry",
      "enabled": true,
      "type": "threshold",
      "threshold": 3,
      "window": "2m",
      "cooldown": "3m",
      "idle": "30m",
      "key_by": "global",
      "max_keys": 2048
    },
    {
      "id": "source_probing",
      "enabled": false,
      "type": "keyed_threshold",
      "threshold": 12,
      "window": "5m",
      "cooldown": "30m",
      "idle": "1h",
      "key_by": "source",
      "max_keys": 2048
    },
    {
      "id": "usb_device_event",
      "enabled": true,
      "type": "immediate",
      "threshold": 1,
      "window": "1m",
      "cooldown": "1m",
      "idle": "2m",
      "key_by": "global",
      "max_keys": 2048,
      "event_id_prefix": "secusb"
    },
    {
      "id": "privilege_event",
      "enabled": true,
      "type": "immediate",
      "threshold": 1,
      "window": "1m",
      "cooldown": "1m",
      "idle": "2m",
      "key_by": "global",
      "max_keys": 2048,
      "event_id_prefix": "secpriv"
    },
    {
      "id": "account_change_event",
      "enabled": true,
      "type": "immediate",
      "threshold": 1,
      "window": "1m",
      "cooldown": "1m",
      "idle": "2m",
      "key_by": "global",
      "max_keys": 2048,
      "event_id_prefix": "secacct"
    },
    {
      "id": "ssh_source_probing",
      "enabled": true,
      "type": "keyed_threshold",
      "threshold": 10,
      "window": "5m",
      "cooldown": "30m",
      "idle": "1h",
      "key_by": "source",
      "max_keys": 2048,
      "event_id_prefix": "secssh"
    }
  ],
  "rules": [
    {
      "id": "pam_auth_failure",
      "enabled": true,
      "source": "auth",
      "category": "auth_failure",
      "pattern": "pam_unix\\((litenas-auth|sshd|login|su|su-l|sudo):auth\\): authentication failure",
      "instance": "single_failure",
      "severity": "warning",
      "lockdown": false
    },
    {
      "id": "pam_password_guessing",
      "enabled": true,
      "source": "auth",
      "category": "password_guessing",
      "pattern": "pam_unix\\((litenas-auth|sshd|login|su|su-l|sudo):auth\\): authentication failure",
      "success_pattern": "pam_unix\\((litenas-auth|sshd|login|su|su-l):session\\): session opened for user",
      "require": ["(^|\\s)user=\\S+"],
      "instance": "account_retry",
      "severity": "critical",
      "email_on_critical": true,
      "lockdown": false
    },
    {
      "id": "pam_unknown_account_guessing",
      "enabled": true,
      "source": "auth",
      "category": "password_guessing",
      "pattern": "pam_unix\\((litenas-auth|sshd|login|su|su-l|sudo):auth\\): authentication failure",
      "exclude": ["(^|\\s)user=\\S+"],
      "instance": "unknown_account_retry",
      "severity": "critical",
      "email_on_critical": true,
      "lockdown": false
    },
    {
      "id": "pam_source_probing",
      "enabled": false,
      "source": "auth",
      "category": "password_guessing",
      "pattern": "pam_unix\\((litenas-auth|sshd|login|su|su-l|sudo):auth\\): authentication failure",
      "instance": "source_probing",
      "severity": "critical",
      "email_on_critical": true,
      "lockdown": false
    },
    {
      "id": "usb_device_connected",
      "enabled": true,
      "source": "kernel",
      "category": "usb_device",
      "pattern": "^usb [0-9]+-[0-9.]+: New USB device found, idVendor=[0-9a-f]{4}, idProduct=[0-9a-f]{4}",
      "exclude": ["idVendor=1d6b,"],
      "instance": "usb_device_event",
      "severity": "critical",
      "email_on_critical": true,
      "lockdown": false
    },
    {
      "id": "sudo_policy_violation",
      "enabled": true,
      "source": "auth",
      "category": "privilege_escalation",
      "pattern": "^[a-z_][a-z0-9_.-]* : +(user NOT in sudoers|user NOT authorized on host|command not allowed) ;",
      "instance": "privilege_event",
      "severity": "critical",
      "email_on_critical": true,
      "lockdown": false
    },
    {
      "id": "privileged_group_membership",
      "enabled": true,
      "source": "auth",
      "category": "privilege_escalation",
      "pattern": "^(add '[^']+' to group '(sudo|admin|adm|root|wheel|shadow|disk|docker|lxd)'|user \\S+ added by \\S+ to group (sudo|admin|adm|root|wheel|shadow|disk|docker|lxd))$",
      "instance": "privilege_event",
      "severity": "critical",
      "email_on_critical": true,
      "lockdown": false
    },
    {
      "id": "login_account_created",
      "enabled": true,
      "source": "auth",
      "category": "account_change",
      "pattern": "^new user: name=[^,]+, UID=[0-9]+, GID=[0-9]+, home=[^,]*, shell=/",
      "exclude": ["shell=/(usr/)?s?bin/(nologin|false),"],
      "instance": "account_change_event",
      "severity": "critical",
      "email_on_critical": true,
      "lockdown": false
    },
    {
      "id": "root_password_changed",
      "enabled": true,
      "source": "auth",
      "category": "account_change",
      "pattern": "pam_unix\\([a-z-]+:chauthtok\\): password changed for root$",
      "instance": "account_change_event",
      "severity": "critical",
      "email_on_critical": true,
      "lockdown": false
    },
    {
      "id": "ssh_preauth_probing",
      "enabled": true,
      "source": "auth",
      "category": "password_guessing",
      "pattern": "^(Invalid user \\S* from|Failed [a-z/-]+ for \\S+ from) ",
      "instance": "ssh_source_probing",
      "severity": "critical",
      "email_on_critical": true,
      "lockdown": false
    }
  ]
}
