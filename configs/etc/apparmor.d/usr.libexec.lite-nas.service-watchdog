abi <abi/4.0>,

include <tunables/global>

profile /usr/libexec/lite-nas/service-watchdog flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/lite-nas-go-base>
  include <abstractions/lite-nas-nats-client>
  include <abstractions/lite-nas-auth-client>
  include <abstractions/authentication>

  capability setuid,
  capability setgid,

  /usr/libexec/lite-nas/service-watchdog mr,
  /etc/lite-nas/service-watchdog.conf r,
  /var/log/lite-nas/service-watchdog.log rw,
  /usr/bin/systemctl ix,
  /run/systemd/** rw,
  /run/dbus/system_bus_socket rw,
  dbus (send, receive) bus=system peer=(name="org.freedesktop.systemd1"),
  /usr/bin/sudo ix,
  /usr/lib/cargo/bin/sudo ix,
  /usr/lib/sudo/** mr,
  /usr/libexec/sudo/** mr,
  /etc/sudo.conf r,
  /etc/sudoers r,
  /etc/sudoers.d/ r,
  /etc/sudoers.d/** r,
  /run/sudo/** rwk,
  /var/db/sudo/** rwk,
  /var/lib/sudo/** rwk,

  include if exists <local/usr.libexec.lite-nas.service-watchdog>
}
