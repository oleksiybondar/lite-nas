abi <abi/4.0>,

include <tunables/global>

profile /usr/libexec/lite-nas/antivirus flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/lite-nas-go-base>
  include <abstractions/lite-nas-nats-client>
  include <abstractions/lite-nas-auth-client>

  capability dac_read_search,
  capability setuid,
  capability setgid,

  /usr/libexec/lite-nas/antivirus mr,
  /etc/lite-nas/antivirus.conf r,
  /var/log/lite-nas/antivirus.log rw,
  /proc/*/mountinfo r,
  # On-demand scans are authorized separately and may target any folder.
  /** r,
  /usr/bin/clamscan ix,
  /usr/bin/sudo ix,
  /usr/lib/cargo/bin/sudo ix,
  /usr/lib/sudo/** mr,
  /usr/libexec/sudo/** mr,
  /etc/sudo.conf r,
  /etc/sudoers r,
  /etc/sudoers.d/ r,
  /etc/sudoers.d/** r,
  /run/sudo/** rwk,
  /var/db/sudo/** rwk,
  /var/lib/sudo/** rwk,
  /usr/bin/systemctl ix,
  /usr/sbin/unix_chkpwd ix,
  /run/dbus/system_bus_socket rw,
  dbus (send, receive) bus=system peer=(name="org.freedesktop.systemd1"),
  /run/systemd/private rw,
  /etc/clamav/freshclam.conf r,
  /etc/clamav/certs/ r,
  /etc/clamav/certs/** r,
  /var/lib/clamav/ r,
  /var/lib/clamav/** r,
  /tmp/** rwk,
  /var/tmp/** rwk,
  include if exists <local/usr.libexec.lite-nas.antivirus>
}
