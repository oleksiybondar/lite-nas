[Unit]
Description=LiteNAS integrity service
After=network-online.target nats-server.service lite-nas-auth.service lite-nas-rbac.service lite-nas-security-logging-manager.service
Wants=network-online.target lite-nas-auth.service lite-nas-rbac.service lite-nas-security-logging-manager.service
Requires=nats-server.service

[Service]
Type=simple
User=lite-nas-integrity
Group=lite-nas-integrity
ExecStart=/usr/libexec/lite-nas/litenas-integrity
Restart=on-failure
RestartSec=5s
WorkingDirectory=/
NoNewPrivileges=no
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.1
IPAddressAllow=::1
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
UMask=0027
ReadOnlyPaths=/etc/lite-nas/litenas-integrity.conf /etc/lite-nas/certificates/transport /etc/lite-nas/certificates/identities
ReadWritePaths=/var/log/lite-nas/lite-nas-integrity.log /var/lib/aide
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
