abi <abi/4.0>,

include <tunables/global>

profile /usr/libexec/lite-nas/session-manager flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/lite-nas-go-base>
  include <abstractions/authentication>

  # sudo keeps this profile while switching to root for the fixed loginctl verbs.
  capability setuid,
  capability setgid,

  network inet stream,
  network inet6 stream,
  network unix stream,
  network unix dgram,

  /usr/libexec/lite-nas/session-manager mr,
  /etc/lite-nas/session-manager.conf r,
  /var/log/lite-nas/session-manager.log rw,
  /etc/lite-nas/certificates/transport/ r,
  /etc/lite-nas/certificates/transport/root-ca.crt r,
  /etc/lite-nas/certificates/transport/lite-nas-session-manager/ r,
  /etc/lite-nas/certificates/transport/lite-nas-session-manager/client.{crt,key} r,
  /etc/lite-nas/certificates/auth/ r,
  /etc/lite-nas/certificates/auth/token-signing.crt r,

  /usr/bin/loginctl ix,
  /run/dbus/system_bus_socket rw,
  dbus (send, receive) bus=system peer=(name="org.freedesktop.login1"),

  /usr/bin/sudo ix,
  /usr/lib/cargo/bin/sudo ix,
  /usr/lib/sudo/** mr,
  /usr/libexec/sudo/** mr,
  /etc/sudo.conf r,
  /etc/sudoers r,
  /etc/sudoers.d/ r,
  /etc/sudoers.d/** r,
  /run/sudo/** rwk,
  /var/db/sudo/** rwk,
  /var/lib/sudo/** rwk,

  include if exists <local/usr.libexec.lite-nas.session-manager>
}
