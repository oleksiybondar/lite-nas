{
  "event_id_prefix": "secauth",
  "sources": [{ "id": "auth", "path": "/var/log/auth.log", "format": "rsyslog_auth" }],
  "instances": [
    {
      "id": "single_failure",
      "enabled": true,
      "type": "immediate",
      "threshold": 1,
      "window": "1m",
      "cooldown": "1m",
      "idle": "2m",
      "key_by": "global",
      "max_keys": 2048
    },
    {
      "id": "account_retry",
      "enabled": true,
      "type": "keyed_threshold",
      "threshold": 3,
      "window": "2m",
      "cooldown": "3m",
      "idle": "30m",
      "key_by": "account",
      "max_keys": 2048
    },
    {
      "id": "unknown_account_retry",
      "enabled": true,
      "type": "threshold",
      "threshold": 3,
      "window": "2m",
      "cooldown": "3m",
      "idle": "30m",
      "key_by": "global",
      "max_keys": 2048
    },
    {
      "id": "source_probing",
      "enabled": false,
      "type": "keyed_threshold",
      "threshold": 12,
      "window": "5m",
      "cooldown": "30m",
      "idle": "1h",
      "key_by": "source",
      "max_keys": 2048
    }
  ],
  "rules": [
    {
      "id": "pam_auth_failure",
      "enabled": true,
      "source": "auth",
      "category": "auth_failure",
      "pattern": "pam_unix\\((litenas-auth|sshd|login|su|su-l):auth\\): authentication failure",
      "instance": "single_failure",
      "severity": "warning",
      "lockdown": false
    },
    {
      "id": "pam_password_guessing",
      "enabled": true,
      "source": "auth",
      "category": "password_guessing",
      "pattern": "pam_unix\\((litenas-auth|sshd|login|su|su-l):auth\\): authentication failure",
      "success_pattern": "pam_unix\\((litenas-auth|sshd|login|su|su-l):session\\): session opened for user",
      "require": ["(^|\\s)user=\\S+"],
      "instance": "account_retry",
      "severity": "critical",
      "email_on_critical": true,
      "lockdown": false
    },
    {
      "id": "pam_unknown_account_guessing",
      "enabled": true,
      "source": "auth",
      "category": "password_guessing",
      "pattern": "pam_unix\\((litenas-auth|sshd|login|su|su-l):auth\\): authentication failure",
      "exclude": ["(^|\\s)user=\\S+"],
      "instance": "unknown_account_retry",
      "severity": "critical",
      "email_on_critical": true,
      "lockdown": false
    },
    {
      "id": "pam_source_probing",
      "enabled": false,
      "source": "auth",
      "category": "password_guessing",
      "pattern": "pam_unix\\((litenas-auth|sshd|login|su|su-l):auth\\): authentication failure",
      "instance": "source_probing",
      "severity": "critical",
      "email_on_critical": true,
      "lockdown": false
    }
  ]
}
