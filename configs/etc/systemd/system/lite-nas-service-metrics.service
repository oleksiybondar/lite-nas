[Unit]
Description=LiteNAS service metrics service
After=network-online.target nats-server.service
Wants=network-online.target
Requires=nats-server.service

[Service]
Type=simple
User=lite-nas-service-metrics
Group=lite-nas-service-metrics
SupplementaryGroups=lite-nas
ExecStart=/usr/libexec/lite-nas/service-metrics
Restart=on-failure
RestartSec=5s
WorkingDirectory=/
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.1
IPAddressAllow=::1
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
ReadOnlyPaths=/etc/lite-nas /etc/systemd/system /run/systemd/system /usr/lib/systemd/system /lib/systemd/system /sys/fs/cgroup/system.slice /dev/null
ReadWritePaths=/var/log/lite-nas/service-metrics.log
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
