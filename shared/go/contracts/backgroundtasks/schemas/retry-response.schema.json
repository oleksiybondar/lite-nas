{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lite-nas.local/contracts/backgroundtasks/retry-response.schema.json",
  "title": "Background task retry response",
  "type": "object",
  "additionalProperties": false,
  "required": ["previous_task_id", "task_id", "state"],
  "properties": {
    "previous_task_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "task_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "state": { "type": "string", "enum": ["queued", "running", "succeeded", "failed", "cancelled"] }
  }
}
