abi <abi/4.0>,

include <tunables/global>

profile /usr/libexec/lite-nas/service-metrics flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/lite-nas-go-base>
  include <abstractions/lite-nas-nats-client>

  /usr/libexec/lite-nas/service-metrics mr,
  /etc/lite-nas/service-metrics.conf r,
  /var/log/lite-nas/service-metrics.log rw,
  /dev/ r,
  /dev/null r,
  /etc/systemd/system/ r,
  /etc/systemd/system/** r,
  /run/systemd/system/ r,
  /run/systemd/system/** r,
  /usr/lib/systemd/system/ r,
  /usr/lib/systemd/system/** r,
  /lib/systemd/system/ r,
  /lib/systemd/system/** r,
  /sys/fs/cgroup/system.slice/ r,
  /sys/fs/cgroup/system.slice/** r,

  include if exists <local/usr.libexec.lite-nas.service-metrics>
}
