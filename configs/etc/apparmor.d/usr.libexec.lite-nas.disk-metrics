abi <abi/4.0>,

include <tunables/global>

profile /usr/libexec/lite-nas/disk-metrics flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/lite-nas-go-base>
  include <abstractions/lite-nas-nats-client>

  /usr/libexec/lite-nas/disk-metrics mr,
  /etc/lite-nas/disk-metrics.conf r,
  /var/log/lite-nas/disk-metrics.log rw,
  /proc/diskstats r,
  /proc/self/mountinfo r,
  /proc/mounts r,
  /sys/block/ r,
  /sys/block/** r,
  /sys/devices/ r,
  /sys/devices/** r,
  /dev/ r,
  /dev/** r,
  /dev/disk/ r,
  /dev/disk/** r,
  /dev/mapper/ r,
  /dev/mapper/** r,

  include if exists <local/usr.libexec.lite-nas.disk-metrics>
}
