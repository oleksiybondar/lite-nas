abi <abi/4.0>,

include <tunables/global>

profile /usr/libexec/lite-nas/antivirus flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/lite-nas-go-base>
  include <abstractions/lite-nas-nats-client>
  include <abstractions/lite-nas-auth-client>

  /usr/libexec/lite-nas/antivirus mr,
  /etc/lite-nas/antivirus.conf r,
  /var/log/lite-nas/antivirus.log rw,
  /proc/*/mountinfo r,
  /usr/bin/clamscan ix,
  /etc/clamav/freshclam.conf r,
  /etc/clamav/certs/ r,
  /etc/clamav/certs/** r,
  /var/lib/clamav/ r,
  /var/lib/clamav/** r,
  /tmp/** rwk,
  /var/tmp/** rwk,
  /media/** r,
  /mnt/** r,

  include if exists <local/usr.libexec.lite-nas.antivirus>
}
